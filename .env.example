# Supabase (opcional: sem estas variáveis o app usa o projeto configurado em src/lib/supabase.ts)
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_ANON_KEY"

# Secrets das Edge Functions (definir no Supabase, nunca no front-end):
#   GOOGLE_SERVICE_ACCOUNT  JSON da service account do Google Drive
#   ALLOWED_ORIGINS         origens permitidas no CORS, separadas por vírgula (ex.: https://app.seudominio.com)
